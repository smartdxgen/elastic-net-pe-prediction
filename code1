def predict_prob(model, X):
    return model.predict_proba(X)[:, 1]


def build_base_model(spline_cols=(), C_value=1.0, l1_ratio=0.5, class_weight=None, random_state=RANDOM_STATE_MODEL):
    steps = []
    if spline_cols:
        steps.append(("pre", ColumnTransformer(
            [("spl", SplineTransformer(n_knots=4, degree=3, knots="quantile", include_bias=False),
              list(spline_cols))], remainder="passthrough")))
    steps += [("scaler", StandardScaler()),
              ("lr", LogisticRegression(**LR_PENALTY_KW, solver="saga", l1_ratio=float(l1_ratio),
                                        C=float(C_value), class_weight=class_weight, max_iter=5000,
                                        random_state=random_state))]
    return Pipeline(steps)


def build_calibrated_model(spline_cols=(), C_value=1.0, l1_ratio=0.5, class_weight=None, platt=USE_PLATT):
    base = build_base_model(spline_cols, C_value, l1_ratio, class_weight)
    if not platt:
        return base
    return CalibratedClassifierCV(estimator=base, method="sigmoid", ensemble=False,
                                  cv=StratifiedKFold(TUNING_INNER_FOLDS, shuffle=True,
                                                     random_state=RANDOM_STATE_MODEL))


def _logloss(y, p):
    p = np.clip(p, 1e-15, 1 - 1e-15)
    return -np.mean(y * np.log(p) + (1 - y) * np.log(1 - p))


def tune_hyperparameters(X, y, spline_cols=(), class_weight=None, n_splits=TUNING_INNER_FOLDS,
                         seed=RANDOM_STATE_MODEL):
    """Inner-CV grid search (mean fold log loss). Scaling/splines are refitted in every inner training fold.
    Platt calibration is deliberately not part of the selection (it is fitted afterwards)."""
    X = X.reset_index(drop=True)
    y = np.asarray(y, dtype=int)
    folds = list(StratifiedKFold(n_splits, shuffle=True, random_state=seed).split(X, y))
    rows = []
    for C in TUNING_C_GRID:
        for l1 in TUNING_L1_GRID:
            losses, aucs = [], []
            for f, (tr, va) in enumerate(folds):
                m = build_base_model(spline_cols, C, l1, class_weight, random_state=seed + f + 1)
                try:
                    m.fit(X.iloc[tr], y[tr])
                    p = predict_prob(m, X.iloc[va])
                    if not np.all(np.isfinite(p)):
                        raise ValueError("non-finite")
                    losses.append(_logloss(y[va], p))
                    if len(np.unique(y[va])) == 2:
                        aucs.append(roc_auc_score(y[va], p))
                except Exception:
                    losses.append(np.inf)
            rows.append({"C": float(C), "l1_ratio": float(l1), "Mean_inner_log_loss": float(np.mean(losses)),
                         "Mean_inner_AUC": float(np.mean(aucs)) if aucs else np.nan})
    res = pd.DataFrame(rows).sort_values(["Mean_inner_log_loss", "C", "l1_ratio"]).reset_index(drop=True)
    return {"C": float(res.loc[0, "C"]), "l1_ratio": float(res.loc[0, "l1_ratio"])}, res


def fit_tuned_model(X, y, spline_cols=(), class_weight=None, seed=RANDOM_STATE_MODEL):
    best, tab = tune_hyperparameters(X, y, spline_cols, class_weight, seed=seed)
    m = build_calibrated_model(spline_cols, best["C"], best["l1_ratio"], class_weight)
    m.fit(X, y)
    return m, best, tab


def nested_cv_oof_predictions(X, y, spline_cols=(), n_outer=TUNING_OUTER_FOLDS, seed=RANDOM_STATE_SPLIT):
    """Out-of-fold predictions; hyper-parameters and Platt calibration are fitted inside each outer training fold."""
    X = X.reset_index(drop=True)
    y = np.asarray(y, dtype=int)
    oof, recs = np.full(len(y), np.nan), []
    for fold, (tr, va) in enumerate(StratifiedKFold(n_outer, shuffle=True, random_state=seed).split(X, y), 1):
        best, _ = tune_hyperparameters(X.iloc[tr], y[tr], spline_cols, seed=seed + fold)
        m = build_calibrated_model(spline_cols, best["C"], best["l1_ratio"])
        m.fit(X.iloc[tr], y[tr])
        oof[va] = predict_prob(m, X.iloc[va])
        recs.append({"Outer_fold": fold, **best})
    return oof, pd.DataFrame(recs)


def extract_equation(cal_model, columns):
    """Fold scaler + elastic-net + ONE Platt sigmoid into logit(p) = intercept + sum(beta_j * x_j) (0/1 coding)."""
    if not hasattr(cal_model, "calibrated_classifiers_"):          # un-calibrated pipeline
        sc, lr = cal_model.named_steps["scaler"], cal_model.named_steps["lr"]
        w, b0, A, B = lr.coef_[0], float(lr.intercept_[0]), -1.0, 0.0
    else:
        cc = cal_model.calibrated_classifiers_[0]
        pipe = getattr(cc, "estimator", None) or getattr(cc, "base_estimator")
        sig = cc.calibrators[0]
        A, B = float(sig.a_), float(sig.b_)                         # p = expit(-(A*f + B))
        sc, lr = pipe.named_steps["scaler"], pipe.named_steps["lr"]
        w, b0 = lr.coef_[0], float(lr.intercept_[0])
    mu, sd = sc.mean_, sc.scale_
    beta = -A * w / sd
    intercept = -A * (b0 - np.sum(w * mu / sd)) - B
    table = pd.DataFrame({"Predictor": columns, "Standardised_coef_before_Platt": w, "Scaler_mean": mu,
                          "Scaler_SD": sd, "Final_coef_original_0/1_coding": beta,
                          "Retained_(non-zero)": np.abs(w) > 1e-8})
    return table, {"Intercept_final": intercept, "Base_model_intercept": b0, "Platt_A": A, "Platt_B": B}, intercept, beta


