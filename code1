def draw_boxes(items, fname, title, size, gap, top, width=0.72, height=0.07):
    fig, ax = plt.subplots(figsize=size)
    ax.set_xlim(0, 1); ax.set_ylim(0, 1); ax.axis("off")
    for i, (txt, col) in enumerate(items):
        y0 = top - i * gap
        ax.add_patch(FancyBboxPatch((0.5 - width / 2, y0 - height / 2), width, height, boxstyle="round,pad=0.012",
                                    ec="black", fc=col, lw=1.2))
        ax.text(0.5, y0, txt, ha="center", va="center", fontsize=10)
        if i < len(items) - 1:
            ax.annotate("", xy=(0.5, y0 - gap + height / 2), xytext=(0.5, y0 - height / 2),
                        arrowprops=dict(arrowstyle="->", lw=1.3))
    ax.text(0.5, 0.995, title, ha="center", va="top", fontsize=14, fontweight="bold")
    save_fig(fname)


