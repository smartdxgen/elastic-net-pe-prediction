    save_csv(tab, f"tuning_grid_{name}_full_cohort.csv")
    res = Parallel(n_jobs=N_JOBS)(delayed(_one_boot)(RANDOM_STATE_MODEL + i, X, yv, sc["spline"], PRIMARY_THRESHOLD)
                                  for i in range(n_boot))
    opt = pd.DataFrame([r for r in res if r is not None])
    save_csv(opt, f"bootstrap_optimism_draws_{name}.csv")
    rows = [{"Scenario": name, "Metric": k, "Apparent": apparent[k], "Mean_optimism": opt[k].mean(),
             "Optimism_corrected": apparent[k] - opt[k].mean(),
             "Approx_CI_lo": apparent[k] - opt[k].quantile(0.975),
             "Approx_CI_hi": apparent[k] - opt[k].quantile(0.025),
             "N_valid_bootstrap_reps": len(opt), "Final_selected_C": best["C"],
             "Final_selected_l1_ratio": best["l1_ratio"]}
            for k in ["AUC", "Brier", "Cal_slope", "CITL", "Sensitivity", "Specificity"]]
    return pd.DataFrame(rows), best, opt


