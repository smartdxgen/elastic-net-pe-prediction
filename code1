def build_threshold_table(y, mp, ws, gs, label):
    y, mp, ws, gs = np.asarray(y), np.asarray(mp, float), np.asarray(ws, float), np.asarray(gs, float)
    m = threshold_row(y, mp, PRIMARY_THRESHOLD, label)
    m["Threshold"] = f"p>={PRIMARY_THRESHOLD:.2f}"
    rows = [m, rule_row(y, ws, WELLS_TABLE_CUT, f"{WELLS_SHORT} >{WELLS_TABLE_CUT:g}"),
            rule_row(y, gs, GENEVA_TABLE_CUT, f"{GENEVA_SHORT} >={GENEVA_TABLE_CUT + 1:g}")]
    t = add_per1000(pd.DataFrame(rows), float(y.mean()))
    t["AUC_continuous_(threshold-independent)"] = [roc_auc_score(y, mp), roc_auc_score(y, ws), roc_auc_score(y, gs)]
    return t


