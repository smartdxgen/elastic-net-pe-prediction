def riley(P, prev, r2, shrink=0.90, margin=0.05):
    max_r2 = 1 - np.exp(2 * (prev * np.log(prev) + (1 - prev) * np.log(1 - prev)))
    n1 = P / ((shrink - 1) * np.log(1 - r2 / shrink))
    s2 = r2 / (r2 + 0.05 * max_r2)
    n2 = P / ((s2 - 1) * np.log(1 - r2 / s2))
    n3 = (1.96 / margin) ** 2 * prev * (1 - prev)
    return max_r2, n1, n2, n3


def sample_size_table(P, n_total, n_events, extra=None):
    prev = n_events / n_total
    mr2 = riley(P, prev, 0.1)[0]
    scen = [("15% of max R2cs (Riley default)", 0.15 * mr2), ("R2cs = 0.10", 0.10),
            ("R2cs = 0.20", 0.20), ("R2cs = 0.30", 0.30)] + (extra or [])
    rows = []
    for lab, r2 in scen:
        _, n1, n2, n3 = riley(P, prev, r2)
        nreq = int(np.ceil(max(n1, n2, n3)))
        rows.append({"Assumed_R2cs": lab, "R2cs": round(r2, 3), "P": P, "n_crit1_shrinkage": int(np.ceil(n1)),
                     "n_crit2_optimism": int(np.ceil(n2)), "n_crit3_risk": int(np.ceil(n3)), "n_required": nreq,
                     "n_available": n_total, "events_required": int(np.ceil(nreq * prev)),
                     "events_available": n_events, "EPP_available": round(n_events / P, 2)})
    return pd.DataFrame(rows)


def cox_snell_r2(y, p):
    y, p = np.asarray(y), np.clip(np.asarray(p, float), 1e-9, 1 - 1e-9)
    ll_m = np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))
    pr = y.mean()
    ll_0 = len(y) * (pr * np.log(pr) + (1 - pr) * np.log(1 - pr))
    return 1 - np.exp(2 * (ll_0 - ll_m) / len(y))


