def _tune_smoten(Xtr, ytr, seed):
    Xtr, ytr = Xtr.reset_index(drop=True), np.asarray(ytr, dtype=int)
    folds = list(StratifiedKFold(TUNING_INNER_FOLDS, shuffle=True, random_state=seed).split(Xtr, ytr))
    rows = []
    for C in TUNING_C_GRID:
        for l1 in TUNING_L1_GRID:
            ls = []
            for f, (a, b) in enumerate(folds):
                Xa, ya = SMOTEN(random_state=seed + f).fit_resample(Xtr.iloc[a], ytr[a])
                mm = build_base_model(C_value=C, l1_ratio=l1, random_state=seed + f + 1).fit(Xa, ya)
                ls.append(_logloss(ytr[b], predict_prob(mm, Xtr.iloc[b])))
            rows.append({"C": C, "l1_ratio": l1, "loss": np.mean(ls)})
    r = pd.DataFrame(rows).sort_values(["loss", "C", "l1_ratio"]).iloc[0]
    return {"C": float(r["C"]), "l1_ratio": float(r["l1_ratio"])}


def _cv_arm_model(name, Xtr, ytr, seed):
    if name == "D_SMOTEN_in_fold":
        best = _tune_smoten(Xtr, ytr, seed)
        return ImbPipeline([("smote", SMOTEN(random_state=seed)), ("scaler", StandardScaler()),
                            ("lr", LogisticRegression(**LR_PENALTY_KW, solver="saga", l1_ratio=best["l1_ratio"],
                                                      C=best["C"], max_iter=5000, random_state=seed))]), best
    cw = "balanced" if name == "C_class_weight_balanced" else None
    best, _ = tune_hyperparameters(Xtr, ytr, class_weight=cw, seed=seed)
    return build_calibrated_model((), best["C"], best["l1_ratio"], cw, platt=(name == "B_platt_PRIMARY")), best


def _cv_repeat(rep, name, X, y):
    oof, sel_ = np.zeros(len(y)), []
    for fold, (tr, va) in enumerate(StratifiedKFold(5, shuffle=True, random_state=1000 + rep).split(X, y), 1):
        m, best = _cv_arm_model(name, X.iloc[tr], y[tr], 1000 + rep * 100 + fold)
        m.fit(X.iloc[tr], y[tr])
        oof[va] = predict_prob(m, X.iloc[va])
        sel_.append(best)
    out = core_metrics(y, oof, PRIMARY_THRESHOLD)
    out.update({"Mean_predicted_risk": float(oof.mean()), "Observed_prevalence": float(y.mean()), "Model": name,
                "Repeat": rep, "Selected_C_median": float(np.median([s["C"] for s in sel_])),
                "Selected_l1_median": float(np.median([s["l1_ratio"] for s in sel_]))})
    return out


