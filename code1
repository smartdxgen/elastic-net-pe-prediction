def rep_df(df, title=None, note=None, max_rows=None, decimals=4, index=False):
    if isinstance(df, pd.Series):
        df = df.to_frame()
    if title:
        _REPORT_PARTS.append(f"**{title}**\n")
    if note:
        _REPORT_PARTS.append(f"_{note}_\n")
    shown = df if max_rows is None else df.head(max_rows)
    txt = shown.round(decimals).to_string(index=index)
    if max_rows is not None and len(df) > max_rows:
        txt += f"\n... ({len(df) - max_rows} more rows truncated; see CSV)"
    _REPORT_PARTS.append("```text\n" + txt + "\n```\n")


