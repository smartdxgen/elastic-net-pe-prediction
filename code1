def _one_boot(seed, X, y, spline, thr):
    rng = np.random.default_rng(seed)
    n = len(y)
    idx = rng.integers(0, n, n)
    yb = y[idx]
    if yb.sum() in (0, n):
        return None
    try:
        Xb = X.iloc[idx].reset_index(drop=True)
        best, _ = tune_hyperparameters(Xb, yb, spline, seed=seed)
        m = build_calibrated_model(spline, best["C"], best["l1_ratio"])
        m.fit(Xb, yb)
        boot = core_metrics(yb, predict_prob(m, Xb), thr)
        orig = core_metrics(y, predict_prob(m, X), thr)
    except Exception:
        return None
    out = {k: boot[k] - orig[k] for k in boot}
    out.update({"Selected_C": best["C"], "Selected_l1_ratio": best["l1_ratio"]})
    return out


def optimism_validation(name, n_boot):
    sc = scenarios[name]
    X = df_analysis[sc["columns"]].reset_index(drop=True)
