def _clip(p):
    return np.clip(np.asarray(p, float), 1e-6, 1 - 1e-6)


def cal_slope_citl(y, p):
    y, lp = np.asarray(y), logit(_clip(p))
    try:
        slope = sm.GLM(y, sm.add_constant(lp), family=sm.families.Binomial()).fit().params[1]
        citl = sm.GLM(y, np.ones((len(y), 1)), family=sm.families.Binomial(), offset=lp).fit().params[0]
    except Exception:
        return np.nan, np.nan
    return slope, citl


def calibration_with_ci(y, p):
    y, lp = np.asarray(y), logit(_clip(p))
    mj = sm.GLM(y, sm.add_constant(lp), family=sm.families.Binomial()).fit()
    mc = sm.GLM(y, np.ones((len(y), 1)), family=sm.families.Binomial(), offset=lp).fit()
    cj, cc_ = mj.conf_int(), mc.conf_int()
    return {"Calibration_slope": mj.params[1], "Slope_lo": cj[1][0], "Slope_hi": cj[1][1],
            "CITL_intercept": mc.params[0], "CITL_lo": cc_[0][0], "CITL_hi": cc_[0][1],
            "Joint_intercept": mj.params[0], "Joint_intercept_lo": cj[0][0], "Joint_intercept_hi": cj[0][1]}


def counts_at_threshold(y, p, thr):
    pred = (np.asarray(p) >= thr).astype(int)
    tn, fp, fn, tp = confusion_matrix(np.asarray(y), pred, labels=[0, 1]).ravel()
    return int(tn), int(fp), int(fn), int(tp)


def rates(tn, fp, fn, tp):
    d = lambda a, b: a / b if b > 0 else np.nan
    return {"Sensitivity": d(tp, tp + fn), "Specificity": d(tn, tn + fp), "PPV": d(tp, tp + fp),
            "NPV": d(tn, tn + fn), "Accuracy": d(tp + tn, tn + fp + fn + tp)}


def threshold_row(y, p, thr, label=""):
    tn, fp, fn, tp = counts_at_threshold(y, p, thr)
    r = rates(tn, fp, fn, tp)
    nums = {"Sensitivity": (tp, tp + fn), "Specificity": (tn, tn + fp), "PPV": (tp, tp + fp),
            "NPV": (tn, tn + fn), "Accuracy": (tp + tn, tn + fp + fn + tp)}
    row = {"Label": label, "Threshold": thr, "TN": tn, "FP": fp, "FN": fn, "TP": tp}
    for k, (a, b) in nums.items():
        lo, hi = proportion_confint(a, b, method="beta") if b > 0 else (np.nan, np.nan)
        row[k], row[k + "_CI_lo"], row[k + "_CI_hi"] = r[k], lo, hi
    return row


def add_per1000(tab, prev):
    """Translate sensitivity/specificity into events per 1000 CTPA-referred patients at the cohort prevalence."""
    t = tab.copy()
    t["Missed_PE_per_1000"] = 1000 * prev * (1 - t["Sensitivity"])
    t["Missed_PE_per_1000_CI_hi"] = 1000 * prev * (1 - t["Sensitivity_CI_lo"])
    t["Test_negative_per_1000"] = 1000 * (prev * (1 - t["Sensitivity"]) + (1 - prev) * t["Specificity"])
    t["False_alarms_per_1000"] = 1000 * (1 - prev) * (1 - t["Specificity"])
    return t


def core_metrics(y, p, thr):
    y = np.asarray(y)
    slope, citl = cal_slope_citl(y, p)
    r = rates(*counts_at_threshold(y, p, thr))
    return {"AUC": roc_auc_score(y, p), "Brier": brier_score_loss(y, p), "Cal_slope": slope, "CITL": citl,
            "Sensitivity": r["Sensitivity"], "Specificity": r["Specificity"]}


def _midrank(x):
    order = np.argsort(x)
    z, n = x[order], len(x)
    t, i = np.zeros(n), 0
    while i < n:
        j = i
        while j < n and z[j] == z[i]:
            j += 1
        t[i:j] = 0.5 * (i + j - 1) + 1
        i = j
    out = np.empty(n)
    out[order] = t
    return out


def delong_aucs_cov(y, preds):
    y = np.asarray(y)
    assert not np.isnan(np.vstack(preds).astype(float)).any(), "NaN in DeLong input"
    order = np.argsort(-y, kind="stable")
    P = np.vstack(preds)[:, order]
    m = int(y.sum())
    n = P.shape[1] - m
    k = P.shape[0]
    tx, ty, tz = np.empty((k, m)), np.empty((k, n)), np.empty((k, m + n))
    for r in range(k):
        tx[r], ty[r], tz[r] = _midrank(P[r, :m]), _midrank(P[r, m:]), _midrank(P[r])
    aucs = tz[:, :m].sum(axis=1) / m / n - (m + 1.0) / 2.0 / n
    v01, v10 = (tz[:, :m] - tx) / n, 1.0 - (tz[:, m:] - ty) / m
    return aucs, np.atleast_2d(np.cov(v01)) / m + np.atleast_2d(np.cov(v10)) / n


def delong_compare(y, a, b):
    aucs, cov = delong_aucs_cov(y, [np.asarray(a), np.asarray(b)])
    diff = aucs[0] - aucs[1]
    se = np.sqrt(max(cov[0, 0] + cov[1, 1] - 2 * cov[0, 1], 1e-12))
    z = diff / se
    return {"AUC_A": aucs[0], "AUC_B": aucs[1], "Difference": diff, "Diff_CI_lo": diff - 1.96 * se,
            "Diff_CI_hi": diff + 1.96 * se, "z": z, "p_value": 2 * (1 - stats.norm.cdf(abs(z)))}


def delong_ci_single(y, p):
    aucs, cov = delong_aucs_cov(y, [np.asarray(p)])
    se = np.sqrt(cov[0, 0])
    return aucs[0], max(aucs[0] - 1.96 * se, 0.0), min(aucs[0] + 1.96 * se, 1.0)


def bootstrap_ci_fixed(y, p, thr, n_boot, seed=RANDOM_STATE_MODEL):
    rng = np.random.default_rng(seed)
    y, p = np.asarray(y), np.asarray(p)
    vals = {k: [] for k in ["AUC", "Brier", "Sensitivity", "Specificity", "PPV", "NPV", "Accuracy"]}
    for _ in range(n_boot):
        idx = rng.integers(0, len(y), len(y))
        yb, pb = y[idx], p[idx]
        if len(np.unique(yb)) < 2:
            continue
        r = rates(*counts_at_threshold(yb, pb, thr))
        vals["AUC"].append(roc_auc_score(yb, pb))
        vals["Brier"].append(brier_score_loss(yb, pb))
        for k in r:
            vals[k].append(r[k])
    return {k: (np.nanpercentile(v, 2.5), np.nanpercentile(v, 97.5)) for k, v in vals.items()}


def binned_calibration(y, p, n_bins):
    y, p = np.asarray(y), np.asarray(p)
    q = pd.qcut(p, n_bins, duplicates="drop")
    rows = []
    for _, idx in pd.Series(np.arange(len(p))).groupby(q, observed=True):
        i = idx.values
        k, n = int(y[i].sum()), len(i)
        lo, hi = proportion_confint(k, n, method="beta")
        rows.append({"Mean_predicted": p[i].mean(), "Observed": k / n, "CI_lo": lo, "CI_hi": hi, "N": n})
    return pd.DataFrame(rows)


def net_benefit(y, p, thrs):
    y, p, n = np.asarray(y), np.asarray(p), len(y)
    nb = []
    for t in thrs:
        tn, fp, fn, tp = counts_at_threshold(y, p, t)
        nb.append(tp / n - fp / n * t / (1 - t))
    prev = y.mean()
    return np.array(nb), prev - (1 - prev) * thrs / (1 - thrs)


