class _Tee:
    """Duplicate stdout into an in-memory buffer so the console log can be embedded in the report."""

    def __init__(self, *streams):
        self.streams = streams

    def write(self, s):
        for st in self.streams:
            try:
                st.write(s)
            except Exception:
                pass
        return len(s)

    def flush(self):
        for st in self.streams:
            try:
                st.flush()
            except Exception:
                pass

    def isatty(self):
        return False


sys.stdout = _Tee(sys.__stdout__, _console_buf)


def _fmt(v, d=4):
    if isinstance(v, (float, np.floating)):
        return "nan" if np.isnan(v) else f"{v:.{d}f}"
