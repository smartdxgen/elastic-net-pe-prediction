def verify_and_save(model, columns, X, tag):
    table, meta, b0, beta = extract_equation(model, columns)
    diff = float(np.max(np.abs(expit(b0 + X[columns].to_numpy() @ beta) - predict_prob(model, X[columns]))))
    meta["Max_abs_difference_vs_sklearn"] = diff
    assert diff < 1e-6, "closed-form equation does not reproduce sklearn predictions"
    save_csv(table.sort_values("Final_coef_original_0/1_coding", key=np.abs, ascending=False),
             f"final_model_coefficients_{tag}.csv")
    return table, meta, b0, beta


